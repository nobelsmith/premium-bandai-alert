[Unit]
Description=Run Premium Bandai monitor every 2 minutes

[Timer]
# OnCalendar is reliable across reboots. OnUnitActiveSec + oneshot can
# stall in "elapsed" with no next trigger (seen after 2026-08-17 reboot).
OnBootSec=30s
OnCalendar=*:0/2
AccuracySec=10s
Persistent=true
Unit=pbandai-monitor.service

[Install]
WantedBy=timers.target
